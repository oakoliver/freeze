{
  "name": "@oakoliver/freeze",
  "version": "1.0.0",
  "description": "Generate images of code and terminal output: SVG, PNG and WebP. A TypeScript port of Charm's freeze",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "freeze": "./dist/cli.js"
  },
  "files": [
    "dist",
    "fonts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build:esm": "esbuild src/index.ts --bundle --format=esm --platform=node --outfile=dist/index.js --target=esnext --packages=external",
    "build:cjs": "esbuild src/index.ts --bundle --format=cjs --platform=node --outfile=dist/index.cjs --target=esnext --packages=external --log-override:empty-import-meta=silent",
    "build:cli": "esbuild src/cli.ts --bundle --format=esm --platform=node --outfile=dist/cli.js --target=esnext --packages=external --banner:js='#!/usr/bin/env node'",
    "build:types": "tsc --emitDeclarationOnly",
    "build": "rm -rf dist && npm run build:esm && npm run build:cjs && npm run build:cli && npm run build:types",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "freeze",
    "screenshot",
    "code",
    "svg",
    "png",
    "webp",
    "syntax-highlighting",
    "terminal",
    "ansi",
    "charmbracelet",
    "cli"
  ],
  "author": "Antonio Oliveira <antonio@oakoliver.com> (https://oakoliver.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oakoliver/freeze"
  },
  "homepage": "https://github.com/oakoliver/freeze#readme",
  "bugs": {
    "url": "https://github.com/oakoliver/freeze/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@oakoliver/huh": "^1.1.2",
    "@oakoliver/lipgloss": "^1.1.3",
    "highlight.js": "^11.11.1"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@oakoliver/bubbles": "^1.2.2",
    "@oakoliver/bubbletea": "^1.2.1",
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "typescript": "^5"
  }
}
